# Optional values for a manually started native API process.
# The systemd units instead load config/monitoring.env and config/backup.env.
DASHBOARD_METRICS_MODE=host
DASHBOARD_ALERT_CPU=90
DASHBOARD_ALERT_MEMORY=90
DASHBOARD_ALERT_STORAGE=85
# Optional host mount points; colon-separated, defaults to /
# DASHBOARD_DISK_PATHS=/:/mnt/storage
# Optional interface names; comma-separated, defaults to automatic selection
# DASHBOARD_NETWORK_INTERFACES=eth0,wlan0
